AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
AWS_REGION=us-east-1
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_BUCKET=gthdf-media
AWS_CDN_URL=http://127.0.0.1:9000/gthdf-media
