{
  "name": "gthf-cms",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "migrate:cities": "node scripts/migrate-cities.js",
    "migrate:cities:remote": "node --env-file=.env scripts/migrate-cities.js --remote",
    "migrate:featured-cities": "node scripts/migrate-featured-city-passages.js",
    "migrate:featured-cities:remote": "node --env-file=.env scripts/migrate-featured-city-passages.js --remote",
    "migrate:chapter-display-order": "node scripts/migrate-chapter-display-order.js",
    "migrate:chapter-display-order:remote": "node scripts/migrate-chapter-display-order.js --remote",
    "migrate:media:ovh-staging": "node scripts/copy-clever-media-to-ovh.mjs",
    "migrate:catalogue-schema": "node scripts/migrate-catalogue-schema.js",
    "migrate:catalogue-schema:remote": "node --env-file=.env scripts/migrate-catalogue-schema.js --remote",
    "provision:datamaster": "tsx scripts/provision-datamaster-role.ts",
    "catalogue:import": "tsx scripts/catalogue.ts import",
    "catalogue:anchors": "tsx scripts/catalogue.ts anchors",
    "catalogue:calculate": "tsx scripts/catalogue.ts calculate",
    "catalogue:archive-check": "tsx scripts/catalogue.ts archive-check",
    "catalogue:media-gc": "tsx scripts/catalogue.ts media-gc",
    "catalogue:apply": "tsx scripts/catalogue.ts apply",
    "catalogue:resume": "tsx scripts/catalogue.ts resume",
    "catalogue:recipe": "node --env-file=.env --import tsx scripts/catalogue-recipe.ts",
    "catalogue:boundaries:check": "python3 data/catalogue/boundaries/check_snapshot.py",
    "catalogue:boundaries:generate": "python3 data/catalogue/boundaries/generate_boundaries.py",
    "prepare:gpx-anchors": "node scripts/prepare-gpx-anchors.js",
    "prepare:gpx-anchors:remote": "node scripts/prepare-gpx-anchors.js --remote",
    "postinstall": "npm run build",
    "seed:example": "node ./scripts/seed.js",
    "test": "tsx --test tests/*.test.ts",
    "test:catalogue": "tsx --test tests/catalogue-*.test.ts",
    "test:integration:prd01": "node scripts/check-prd01-local.js",
    "seed:remote": "./scripts/seed-remote.sh",
    "setup:cellar": "node ./scripts/setup-cellar.js",
    "setup:cellar:policy": "./scripts/setup-cellar-policy.sh",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "delivery:storage:check": "node scripts/check-delivery-storage.mjs",
    "test:delivery": "tsx --test tests/delivery-staging.test.ts tests/release-health.test.ts tests/schema-lock.test.ts",
    "delivery:staging:prepare": "node scripts/prepare-delivery-staging.mjs",
    "test:e2e": "node ../gthf-frontend/infrastructure/delivery/recipe.mjs",
    "test:recovery:journal": "node dist/scripts/recovery/check-journal.js",
    "test:e2e:media-admin": "node scripts/recovery/media-admin.mjs"
  },
  "dependencies": {
