      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tsx": "^4.23.7",
    "typescript": "^5"
  },
  "engines": {
